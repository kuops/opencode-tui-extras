{
  "name": "opencode-context-sidebar",
  "version": "1.1.0",
  "description": "Provider-agnostic Context, Skills, and MCP sidebars for OpenCode TUI",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts",
      "config": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "build": "node clean.mjs && tsc && node build.tui.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "open": "11.0.4"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26",
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/core": ">=0.4.0",
    "@opentui/solid": ">=0.4.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.26",
    "@opencode-ai/plugin": "latest",
    "@opencode/theme": "^2.0.16",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.12",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kuops/opencode-context-sidebar.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "context",
    "tokens",
    "cache",
    "mcp",
    "powerline",
    "skills"
  ],
  "files": [
    "dist",
    "images"
  ]
}
